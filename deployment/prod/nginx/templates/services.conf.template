
ssl_session_cache   shared:SSL:10m;
ssl_session_timeout 10m;

resolver 127.0.0.11 valid=30s;

limit_req_zone $binary_remote_addr zone=email_code_send:10m rate=2r/m;
limit_req_zone $binary_remote_addr zone=email_code_redeem:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=sign_in_challenge:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=business_link_resolve:10m rate=30r/m;
limit_req_status 429;
limit_req_log_level warn;

map $http_authorization $admin_sent_credentials {
    "" 0;
    default 1;
}
map "$admin_sent_credentials $host $request_method $uri" $admin_login_request {
    default 0;
    "~^[01] grafana\.[^ ]+ POST /login$" 1;
    "~^[01] admin\.[^ ]+ POST /api/v[0-9]+(/db)?/auth/user/signin$" 1;
    "~^[01] dozzle\.[^ ]+ POST /api/token$" 1;
    "~^[01] vpn\.[^ ]+ POST /api/session$" 1;
    "~^1 prometheus\.[^ ]+ GET /(?!api/)[^.]*$" 1;
}
map "$admin_login_request:$status" $admin_auth {
    default "";
    "~^1:[23]" "login";
    "~^1:" "failed";
}
log_format admin_auth escape=json '{"admin_auth":"$admin_auth","host":"$host","remote_addr":"$remote_addr","method":"$request_method","uri":"$uri","status":"$status"}';

map $http_user_agent $site_client {
    "" bot;
    "~*(bot|crawl|spider|slurp|scan|preview|facebookexternalhit|headless|lighthouse|curl|wget|python|go-http|java/|okhttp|httpclient|axios|node-fetch|libwww|monitor)" bot;
    "~*(mobi|android|iphone|ipad|ipod)" mobile;
    default desktop;
}
map $uri $site_kind {
    "~*\.(js|mjs|css|map|wasm|png|jpe?g|gif|svg|webp|avif|ico|woff2?|ttf|otf|json|txt|xml|webmanifest)$" asset;
    default page;
}
map $http_referer $site_referrer_host {
    "~*^https?://(?<site_referrer_name>[^/:?#]+)" $site_referrer_name;
    default "";
}
map "$site_referrer_host $host" $site_referrer {
    "~*^(?:www\.)?([^ ]+) (?:www\.)?\1$" "";
    default $site_referrer_host;
}
map $http_origin $site_cors_origin {
    "https://${SITE_DOMAIN_NAME}" $http_origin;
    "https://www.${SITE_DOMAIN_NAME}" $http_origin;
    "https://app.${SITE_DOMAIN_NAME}" $http_origin;
    default "";
}
map $site_cors_origin $site_cors_methods {
    "" "";
    default "GET, POST, PUT, PATCH, DELETE, OPTIONS";
}
map $site_cors_origin $site_cors_headers {
    "" "";
    default "Authorization, Content-Type, Accept, Accept-Language, Idempotency-Key, User-Agent, X-Debug, X-App-Version, X-Platform";
}
map $site_cors_origin $site_cors_expose {
    "" "";
    default "Content-Disposition";
}
map $site_cors_origin $site_cors_max_age {
    "" "";
    default "86400";
}
log_format site_access escape=json '{"log":"site","host":"$host","remote_addr":"$remote_addr","method":"$request_method","uri":"$uri","status":"$status","bytes":"$body_bytes_sent","request_time":"$request_time","upstream_status":"$upstream_status","kind":"$site_kind","client":"$site_client","referrer":"$site_referrer","country":"$http_cf_ipcountry"}';

upstream authorization.service {
    zone authorization.service 64k;
    server authorization.service:80 resolve;
    keepalive 16;
    keepalive_timeout 30s;
}
upstream user.service {
    zone user.service 64k;
    server user.service:80 resolve;
    keepalive 16;
    keepalive_timeout 30s;
}
upstream business.service {
    zone business.service 64k;
    server business.service:80 resolve;
    keepalive 16;
    keepalive_timeout 30s;
}
upstream appointments.service {
    zone appointments.service 64k;
    server appointments.service:80 resolve;
    keepalive 16;
    keepalive_timeout 30s;
}
upstream notifications.service {
    zone notifications.service 64k;
    server notifications.service:80 resolve;
    keepalive 16;
    keepalive_timeout 30s;
}
upstream site.service {
    zone site.service 64k;
    server site.service:8080 resolve;
    keepalive 16;
    keepalive_timeout 30s;
}
upstream webapp.service {
    zone webapp.service 64k;
    server webapp.service:8081 resolve;
    keepalive 16;
    keepalive_timeout 30s;
}

server {
    listen 80;
    server_name         ${DOMAIN_NAME} www.${DOMAIN_NAME};

    return 301 https://$host$request_uri;
}

server {
  listen 443 ssl;
  http2 on;
  server_name         dozzle.${DOMAIN_NAME};
  access_log  /var/log/nginx/access.log admin_auth if=$admin_auth;

  ssl_certificate     /etc/nginx/ssl/${DOMAIN_NAME}/fullchain.pem;
  ssl_certificate_key /etc/nginx/ssl/${DOMAIN_NAME}/key.pem;

  ssl_protocols       TLSv1.2 TLSv1.3;
  ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
  ssl_prefer_server_ciphers off;

  ssl_session_cache   shared:SSL:10m;
  ssl_session_timeout 1d;
  ssl_session_tickets off;

  allow ${VPN_SUBNET};
  deny all;

  location / {
      set $upstream dozzle;
      proxy_pass http://$upstream:8080;
  }
}

