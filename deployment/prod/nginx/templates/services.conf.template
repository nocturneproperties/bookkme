
ssl_session_cache   shared:SSL:10m;
ssl_session_timeout 10m;

resolver 127.0.0.11 valid=30s;

limit_req_zone $binary_remote_addr zone=email_code_send:10m rate=2r/m;
limit_req_zone $binary_remote_addr zone=email_code_redeem:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=sign_in_challenge:10m rate=10r/m;
limit_req_status 429;
limit_req_log_level warn;

upstream authorization.service {
    zone authorization.service 64k;
    server authorization.service:80 resolve;
    keepalive 16;
    keepalive_timeout 30s;
}
upstream user.service {
    zone user.service 64k;
    server user.service:80 resolve;
    keepalive 16;
    keepalive_timeout 30s;
}
upstream business.service {
    zone business.service 64k;
    server business.service:80 resolve;
    keepalive 16;
    keepalive_timeout 30s;
}
upstream appointments.service {
    zone appointments.service 64k;
    server appointments.service:80 resolve;
    keepalive 16;
    keepalive_timeout 30s;
}
upstream notifications.service {
    zone notifications.service 64k;
    server notifications.service:80 resolve;
    keepalive 16;
    keepalive_timeout 30s;
}

server {
    listen 80;
    server_name         ${DOMAIN_NAME} www.${DOMAIN_NAME};

    return 301 https://$host$request_uri;
}

server {
  listen 443 ssl;
  http2 on;
  server_name         dozzle.${DOMAIN_NAME};
  access_log  off;

  ssl_certificate     /etc/nginx/ssl/${DOMAIN_NAME}/fullchain.pem;
  ssl_certificate_key /etc/nginx/ssl/${DOMAIN_NAME}/key.pem;

  ssl_protocols       TLSv1.2 TLSv1.3;
  ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
  ssl_prefer_server_ciphers off;

  ssl_session_cache   shared:SSL:10m;
  ssl_session_timeout 1d;
  ssl_session_tickets off;

  allow ${VPN_SUBNET};
  deny all;

  location / {
      set $upstream dozzle;
      proxy_pass http://$upstream:8080;
  }
}

