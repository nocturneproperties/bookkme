server {
  listen 443 ssl;
  http2 on;
  server_name         ${DOMAIN_NAME} www.${DOMAIN_NAME};
  include             /etc/nginx/snippets/cloudflare-real-ip.conf;

  ssl_certificate     /etc/nginx/ssl/${DOMAIN_NAME}/fullchain.pem;
  ssl_certificate_key /etc/nginx/ssl/${DOMAIN_NAME}/key.pem;

  ssl_protocols       TLSv1.2 TLSv1.3;
  ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
  ssl_prefer_server_ciphers off;

  ssl_session_cache   shared:SSL:10m;
  ssl_session_timeout 1d;
  ssl_session_tickets off;

  location = /.well-known/apple-app-site-association {
     default_type application/json;
     alias /srv/static/ios_well_known.json;
  }
  location = /.well-known/assetlinks.json {
     default_type application/json;
     alias /srv/static/android_well_known.json;
  }
  proxy_http_version 1.1;
  proxy_set_header Connection "";

  location = /api/auth/passkey/sign_in/challenge {
      limit_req zone=sign_in_challenge burst=20 nodelay;
      proxy_pass http://authorization.service;
  }
  location = /api/auth/passkey/sign_up/challenge {
      limit_req zone=email_code_send burst=5 nodelay;
      proxy_pass http://authorization.service;
  }
  location = /api/auth/email {
      limit_req zone=email_code_send burst=5 nodelay;
      proxy_pass http://authorization.service;
  }
  location = /api/auth/sign_up {
      limit_req zone=email_code_redeem burst=10 nodelay;
      proxy_pass http://authorization.service;
  }
  location = /api/auth/email/confirm {
      limit_req zone=email_code_redeem burst=10 nodelay;
      proxy_pass http://authorization.service;
  }
  location /api/auth {
      proxy_pass http://authorization.service;
  }
  location /api/user {
      proxy_pass http://user.service;
  }
  location /api/business {
      proxy_pass http://business.service;
  }
  location /api/appointments {
      proxy_pass http://appointments.service;
  }
  location /api/notifications {
      proxy_pass http://notifications.service;
  }
}