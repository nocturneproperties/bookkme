[mariadb]
innodb_buffer_pool_size    = 2G
innodb_log_file_size       = 512M
innodb_io_capacity         = 1000
innodb_flush_neighbors     = 0
wait_timeout               = 600
log_bin                    = binlog
binlog_format              = ROW
binlog_ignore_db           = user_short_retention
binlog_ignore_db           = business_short_retention
binlog_ignore_db           = appointments_short_retention
binlog_ignore_db           = notifications_short_retention
server_id                  = 1
sync_binlog                = 1
max_binlog_size            = 64M
binlog_expire_logs_seconds = 172800
