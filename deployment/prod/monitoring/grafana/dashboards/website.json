          "expr": "sum by (country) (count_over_time({stack=\"nginx\", service=\"nginx\"} |= `\"log\":\"site\"` | json | kind=\"page\" and status=~\"2..\" and client!=\"bot\" and country!=\"\" [$__auto]))",
