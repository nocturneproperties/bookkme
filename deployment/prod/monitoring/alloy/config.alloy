discovery.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "15s"
}

discovery.relabel "containers" {
  targets = []

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_swarm_service_name"]
    regex         = ".+"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_stack_namespace"]
    target_label  = "stack"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_swarm_service_name"]
    regex         = "[^_]+_(.+)"
    target_label  = "service"
  }

  rule {
    target_label = "node"
    replacement  = constants.hostname
  }
}

loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.containers.targets
  relabel_rules = discovery.relabel.containers.rules
  forward_to    = [loki.process.containers.receiver]
}

loki.process "containers" {
  stage.match {
    selector = "{stack=\"monolith\", service=\"monolith\"}"

    stage.multiline {
      firstline     = "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}"
      max_wait_time = "3s"
    }

    stage.drop {
      expression = "\\], GET /metrics$"
    }

    stage.regex {
      expression = "^\\S+ \\S+ \\[(?P<level>[A-Z]+)\\s*\\]"
    }

    stage.template {
      source   = "level"
      template = "{{ ToLower .Value }}"
    }

    stage.structured_metadata {
      values = { level = "" }
    }
  }

  stage.match {
    selector = "{stack=\"nginx\", service=\"nginx\"} |= \"\\\"log\\\":\\\"site\\\"\""

    stage.json {
      expressions = { status = "", bytes = "", request_time = "", kind = "", client = "" }
    }

    stage.regex {
      source     = "status"
      expression = "^(?P<status_class>[1-5])\\d\\d$"
    }

    stage.template {
      source   = "status_class"
      template = "{{ if .Value }}{{ .Value }}xx{{ else }}other{{ end }}"
    }

    stage.labels {
      values = { status_class = "", kind = "", client = "" }
    }

    stage.metrics {
      metric.counter {
        name              = "requests_total"
        prefix            = "site_"
        description       = "Website requests answered by nginx"
        match_all         = true
        action            = "inc"
        max_idle_duration = "720h"
      }

      metric.counter {
        name              = "response_bytes_total"
        prefix            = "site_"
        description       = "Website response body bytes sent by nginx"
        source            = "bytes"
        action            = "add"
        max_idle_duration = "720h"
      }

      metric.histogram {
        name              = "request_duration_seconds"
        prefix            = "site_"
        description       = "Website request time measured by nginx"
        source            = "request_time"
        buckets           = [0.005, 0.01, 0.025, 0.05, 0.1, 0.25, 0.5, 1, 2.5, 5, 10]
        max_idle_duration = "720h"
      }
    }

    stage.label_drop {
      values = ["status_class", "kind", "client"]
    }
  }

  forward_to = [loki.write.default.receiver]
}

loki.relabel "journal" {
  forward_to = []

  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }
}

loki.source.journal "ssh" {
  matches       = "_SYSTEMD_UNIT=ssh.service"
  relabel_rules = loki.relabel.journal.rules
  labels        = { source = "journal", node = constants.hostname }
  forward_to    = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
